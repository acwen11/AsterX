# Schedule definitions for thorn AsterX

STORAGE: cons_vector[timelevels]
STORAGE: Avec_x[timelevels]
STORAGE: Avec_y[timelevels]
STORAGE: Avec_z[timelevels]
STORAGE: Psi[timelevels]

STORAGE: rhs_vector Avec_x_rhs Avec_y_rhs Avec_z_rhs Psi_rhs
STORAGE: flux_x flux_y flux_z

STORAGE: dB dBx_stag[2] dBy_stag[2] dBz_stag[2]
STORAGE: G Fbeta Fx_stag Fy_stag Fz_stag
STORAGE: Ex Ey Ez
STORAGE: vbar_xface vbar_yface vbar_zface
STORAGE: a_xface a_yface a_zface

STORAGE: con2prim_flag diagnostics
STORAGE: saved_prims
STORAGE: zvec svec
STORAGE: LOflag[2] etac

STORAGE: theta_x theta_y theta_z theta_tot

STORAGE: cons_vector_pv[2]
STORAGE: Avec_x_la[timelevels]
STORAGE: Avec_y_la[timelevels]
STORAGE: Avec_z_la[timelevels]
STORAGE: rhs_vector_pv Avec_x_la_rhs Avec_y_la_rhs Avec_z_la_rhs
STORAGE: CA_C2P
if(use_ho_fv) {
  STORAGE: cons_aux
  STORAGE: cons_pv_iter
  STORAGE: dBx_stag_fa dBy_stag_fa dBz_stag_fa
  STORAGE: dBx_stag_aux dBy_stag_aux dBz_stag_aux
  STORAGE: dBstag_pv_iter
}

if(unit_test)
{
  SCHEDULE AsterX_Test AT wragh
  {
    LANG: C
    OPTIONS: meta
  } "Self-test"
}

if(local_estimate_error)
{  
  SCHEDULE AsterX_EstimateError_Setup AT wragh
  {
    LANG: C
    OPTIONS: GLOBAL
  } "set up for calculating regrid error"

  SCHEDULE AsterX_EstimateError IN ODESolvers_EstimateError
  {
    LANG: C
    READS: HydroBaseX::rho(everywhere) HydroBaseX::vel(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere)
    WRITES: CarpetXRegrid::regrid_error(interior)
  } "Estimate local error for regridding initial conditions"
}



SCHEDULE GROUP AsterX_InitialGroup AT initial IN ODESolvers_Initial AFTER HydroBaseX_PostInitial 
{
} "Initialize conservative variables"

SCHEDULE AsterX_CAC2PFlagOff IN AsterX_InitialGroup
{
  LANG: C
  OPTIONS: global
  WRITES: CA_C2P(everywhere)
} "Disable cell average C2P flag"

SCHEDULE AsterX_InitLOFlag IN AsterX_InitialGroup
{
	LANG: C
	WRITES: LOflag(everywhere)
} "Init this flag to 0"

if (!use_ho_fv) {
  SCHEDULE AsterX_ComputedBstagFromA IN AsterX_InitialGroup
  {
    LANG: C
    READS: Avec_x(everywhere) Avec_y(everywhere) Avec_z(everywhere)
    WRITES: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
  } "Calculate dBstag from curl of A"
} else {
  # HO FV: MHD subsystem part 1 - get point val. dB_stag and dB, initially for CA C2P only
  SCHEDULE AsterX_ComputeAvgdBstagFromAvgA IN AsterX_InitialGroup
  {
    LANG: C
    READS: Avec_x_la(everywhere) Avec_y_la(everywhere) Avec_z_la(everywhere)
    WRITES: dBx_stag_fa(everywhere) dBy_stag_fa(everywhere) dBz_stag_fa(everywhere)
    WRITES: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
  } "Calculate <dBstag> from curl of <A>"

  SCHEDULE AsterX_SetdBstagIter IN AsterX_InitialGroup AFTER AsterX_ComputeAvgdBstagFromAvgA 
  {
    LANG: C
    OPTIONS: global
    WRITES: dBstag_pv_iter(everywhere)
  } "Start counter for dBstag iterative calculation"

  SCHEDULE GROUP AsterX_dBstagPVSolve IN AsterX_InitialGroup AFTER AsterX_SetdBstagIter WHILE AsterX::dBstag_pv_iter
  {
  } "Iteratively calculate point valued dBstag"

  SCHEDULE AsterX_SetdBstagnMinus1 IN AsterX_dBstagPVSolve 
  {
    LANG: C
    READS: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
    READS: dBx_stag_fa(everywhere) dBy_stag_fa(everywhere) dBz_stag_fa(everywhere)
    READS: dBstag_pv_iter(everywhere)
    WRITES: dBx_stag_aux(everywhere) dBy_stag_aux(everywhere) dBz_stag_aux(everywhere)
  } "Set previous dBstag"

  SCHEDULE AsterX_ComputedBstagIter IN AsterX_dBstagPVSolve AFTER AsterX_SetdBstagnMinus1 
  {
    LANG: C
    READS: dBx_stag_fa(everywhere) dBy_stag_fa(everywhere) dBz_stag_fa(everywhere)
    READS: dBx_stag_aux(everywhere) dBy_stag_aux(everywhere) dBz_stag_aux(everywhere)
    WRITES: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
  } "Iterate dBstag"

  SCHEDULE AsterX_DecdBstagIter IN AsterX_dBstagPVSolve AFTER AsterX_ComputedBstagIter 
  {
    LANG: C
    OPTIONS: global
    WRITES: dBstag_pv_iter(everywhere)
  } "Decrement counter for dBstag iterative calculation"
}

if(!use_subcycling && prolongate_dbstag)
{
  SCHEDULE AsterX_ProlongatedBstag IN AsterX_InitialGroup AFTER AsterX_ComputedBstagFromA AFTER AsterX_dBstagPVSolve BEFORE AsterX_ComputedBFromdBstag
  {
    LANG: C
    OPTIONS: global
  } "Prolongate dBstag only"
}

SCHEDULE AsterX_ComputedBFromdBstag IN AsterX_InitialGroup AFTER AsterX_ComputedBstagFromA AFTER AsterX_dBstagPVSolve 
{
  LANG: C
  READS: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
  WRITES: dB(everywhere)
} "Calculate centered dB from dBstag"

# Extra interprocessor syncs only for higher order stencils
if ((mag_correction_order > 2) || use_ho_fv) {
  SCHEDULE AsterX_CommdBstag IN AsterX_InitialGroup AFTER AsterX_ComputedBstagFromA AFTER AsterX_dBstagPVSolve BEFORE AsterX_ProlongatedBstag BEFORE AsterX_ComputedBFromdBstag 
  {
    LANG: C
    OPTIONS: global
  } "Communicate dBstag between processes"

  SCHEDULE AsterX_CommdB IN AsterX_InitialGroup AFTER AsterX_ComputedBFromdBstag BEFORE AsterX_ComputeBFromdB 
  {
    LANG: C
    OPTIONS: global
  } "Communicate cell centered dB between processes"
}

SCHEDULE AsterX_ComputeBFromdB IN AsterX_InitialGroup AFTER AsterX_ComputedBFromdBstag
{
  LANG: C
  READS: dB(everywhere) ADMBaseX::metric(everywhere)
  WRITES: HydroBaseX::Bvec(everywhere)
} "Calculate centered B from densitized B"

SCHEDULE AsterX_CheckPrims IN AsterX_InitialGroup AFTER AsterX_ComputeBFromdB
{
  LANG: C
  READS: ADMBaseX::metric(everywhere)
  READS: HydroBaseX::rho(everywhere) HydroBaseX::vel(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere) HydroBaseX::temperature(everywhere) HydroBaseX::Bvec(everywhere)
  READS: HydroBaseX::entropy(everywhere) HydroBaseX::Ye(everywhere)
  WRITES: HydroBaseX::rho(everywhere) HydroBaseX::vel(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere)
  WRITES: HydroBaseX::temperature(everywhere) HydroBaseX::entropy(everywhere) HydroBaseX::Ye(everywhere)
  WRITES: saved_prims(everywhere)
  WRITES: con2prim_flag(everywhere)
  WRITES: zvec(everywhere)
  WRITES: svec(everywhere)
} "Enforce limits on primitive variables"

if (use_deriv_shock_detector)
{
  SCHEDULE GROUP AsterX_LOFlagGroup IN AsterX_InitialGroup AFTER AsterX_CheckPrims
  {
  } "Detect shocks, flag for low-order recon fallback"

  SCHEDULE GROUP AsterX_LOFlagGroup IN CCTK_POSTSTEP
  {
  } "Detect shocks, flag for low-order recon fallback"

  SCHEDULE AsterX_SetLOeta IN AsterX_LOFlagGroup
  {
    LANG: C
    READS: HydroBaseX::rho(interior) HydroBaseX::vel(interior) HydroBaseX::eps(interior) HydroBaseX::press(interior) HydroBaseX::temperature(interior) HydroBaseX::Ye(interior) #HydroBaseX::Bvec(interior)
    WRITES: etac(interior)
    SYNC: etac
  } "Evaluate smoothness measure eta"

  SCHEDULE AsterX_SetLOFlag IN AsterX_LOFlagGroup
  {
    LANG: C
    READS: etac(interior)
    READS: HydroBaseX::rho(interior)
    WRITES: LOflag(interior)
    SYNC: LOflag
  } "Flag points with high eta"

  SCHEDULE AsterX_LOFlagCopyTLs IN AsterX_InitialGroup AFTER AsterX_LOFlagGroup
  {
    LANG: C
    READS: LOflag(everywhere)
    WRITES: LOflag_p(everywhere)
  } "Initial copy of LOflag to previous timelevels"

  # SCHEDULE GROUP AsterX_LOFlagPostRegridGroup IN CCTK_POSTREGRID IN AsterX_Con2PrimGroup AFTER AsterX_CommdB BEFORE AsterX_ComputedBstagLO
  # {
  # } "Compute low-order flag using prolongated evolved quantities, i.e. cell averaged conservatives"

  # SCHEDULE AsterX_CAC2PFlagOn IN AsterX_LOFlagPostRegridGroup 
  # {
  #   LANG: C
  #   OPTIONS: global
  #   WRITES: CA_C2P(everywhere)
  # } "Indicate C2P to be performed on cell averaged quantities"
  # 
  # SCHEDULE AsterX_Con2Prim IN AsterX_LOFlagPostRegridGroup AFTER AsterX_InitCAC2PFlag
  # {
  #   LANG: C
  #   READS: AsterMasks::aster_mask_vc(everywhere)
  #   READS: ADMBaseX::metric(everywhere)
  #   READS: ADMBaseX::lapse(everywhere)
  #   READS: cons_vector(everywhere) dB(everywhere)
  #   READS: cons_vector_pv(everywhere)
  #   READS: ADMBaseX::shift(everywhere)
  #   READS: saved_prims(everywhere)
  #   READS: Avec_x(everywhere) Avec_y(everywhere) Avec_z(everywhere)
  #   READS: CA_C2P(everywhere)
  #   WRITES: con2prim_flag(everywhere)
  #   WRITES: diagnostics(everywhere)
  #   WRITES: AsterMasks::aster_mask_cc(everywhere)
  #   WRITES: HydroBaseX::rho(everywhere) HydroBaseX::vel(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere) HydroBaseX::Bvec(everywhere)
  #   WRITES: HydroBaseX::temperature(everywhere) HydroBaseX::entropy(everywhere) HydroBaseX::Ye(everywhere)
  #   WRITES: saved_prims(everywhere)
  #   WRITES: zvec(everywhere)
  #   WRITES: svec(everywhere)
  #   WRITES: cons_vector(everywhere) cons_vector_pv(everywhere) dB(everywhere)
  # } "Calculate primitive variables from cell averaged conservatives only to calculate low order flag postregrid"

  # SCHEDULE AsterX_CAC2PFlagOff IN AsterX_LOFlagPostRegridGroup AFTER AsterX_Con2Prim
  # {
  #   LANG: C
  #   OPTIONS: global
  #   WRITES: CA_C2P(everywhere)
  # } "Disable cell average C2P flag"

  # SCHEDULE AsterX_SetLOFlag IN AsterX_LOFlagPostRegridGroup AFTER AsterX_Con2Prim
  # {
  #   LANG: C
  #   #READS: ADMBaseX::metric(interior)
  #   READS: HydroBaseX::rho(interior) HydroBaseX::vel(interior) HydroBaseX::eps(interior) HydroBaseX::press(interior) HydroBaseX::temperature(interior) HydroBaseX::Ye(interior) #HydroBaseX::Bvec(interior)
  #   WRITES: etac(interior) LOflag(interior)
  #   SYNC: LOflag
  # } "Detect shocks, flag for low-order recon fallback"
  
  SCHEDULE AsterX_SetLOFlagPostRegridInitial IN CCTK_POSTREGRID BEFORE ODESolvers_PostStep
  {
    LANG: C
    WRITES: LOflag(everywhere)
  } "Init flag to 0 for grid setup only"

  if (use_ho_fv && shock_pv_fallback)
  {
    SCHEDULE AsterX_PVConsFallback IN CCTK_POSTSTEP AFTER AsterX_SetLOFlag
    {
      LANG: C
      READS: LOflag(everywhere) LOflag_p(everywhere) cons_vector_pv(everywhere)
      WRITES: cons_vector(everywhere)
    } "Overwrite CA with point value in presence of flag"

    # SCHEDULE AsterX_PVConsFallback IN CCTK_POSTREGRID AFTER ODESolvers_PostStep
    # {
    #   LANG: C
    #   READS: LOflag(everywhere) cons_vector_pv(everywhere)
    #   WRITES: cons_vector(everywhere)
    # } "Overwrite CA with point value in presence of flag"
  }
} else {
  SCHEDULE AsterX_InitLOFlag IN AsterX_Con2PrimGroup AFTER AsterX_ApplyOuterBCOnPrim 
  {
    LANG: C
    WRITES: LOflag(everywhere)
  } "Init this flag to 0"
}

SCHEDULE AsterX_Prim2Con_Initial IN AsterX_InitialGroup AFTER AsterX_CheckPrims
{
  LANG: C
  READS: ADMBaseX::metric(interior)
  READS: HydroBaseX::rho(interior) HydroBaseX::vel(interior) HydroBaseX::eps(interior) HydroBaseX::press(interior) HydroBaseX::Bvec(interior)
  READS: HydroBaseX::entropy(interior) HydroBaseX::Ye(interior)
  WRITES: cons_vector(interior) dB(interior)
  WRITES: cons_vector_pv(interior)
  SYNC: cons_vector cons_vector_pv dB 
} "Compute conserved variables from primitive variables at initial"

SCHEDULE AsterX_SetLineAvgAvec_Initial IN AsterX_InitialGroup BEFORE AsterX_ComputeAvgdBstagFromAvgA 
{
  LANG: C
  READS: Avec_x(interior) Avec_y(interior) Avec_z(interior) 
  WRITES: Avec_x_la(interior) Avec_y_la(interior) Avec_z_la(interior) 
  SYNC: Avec_x_la, Avec_y_la, Avec_z_la
} "Compute line-averages of vector potential"

if (use_ho_fv) {
  SCHEDULE AsterX_SetCellAverage IN AsterX_InitialGroup AFTER AsterX_Prim2Con_Initial AFTER AsterX_SetLOFlag BEFORE AsterX_CommConsCA
  {
    LANG: C
    READS: cons_vector_pv(everywhere) 
    READS: LOflag(everywhere) con2prim_flag(everywhere)
    WRITES: cons_vector(everywhere)
  } "Compute cell-averages of conserved variables"

  SCHEDULE AsterX_CommConsCA IN AsterX_InitialGroup AFTER AsterX_SetCellAverage BEFORE AsterX_TouchNonEvolVarsGroup 
  {
    LANG: C
    OPTIONS: global
  } "Communicate conservatives between processes"
}

if (zero_psi) {
  SCHEDULE AsterX_PsiZero_Initial IN AsterX_InitialGroup AFTER AsterX_Prim2Con_Initial
  {
    LANG: C
    WRITES: Psi(everywhere)
  } "Set Psi, time component of 4-vector potential, to zero initially"
}

################################################################################
# For bypassing CarpetX NaN guard only:
#   1. which can be removed if we add new 'where' type corresponding to the new
#      loops used in CalcAuxTermsForAvecPsiRHS, Fluxes, etc.
#   2. values set here are meaning less, they should be set somewhere fully
#      (AsterX_CalcAuxTermsForAvecPsiRHS, Fluxes, etc)
################################################################################

SCHEDULE GROUP AsterX_TouchNonEvolVarsGroup IN AsterX_InitialGroup AFTER AsterX_Prim2Con_Initial
{
} "Touch Non-Evolution Variables to Bypass CarpetX NaN guard"

SCHEDULE GROUP AsterX_TouchNonEvolVarsGroup AT postregrid
{
} "Touch Non-Evolution Variables to Bypass CarpetX NaN guard"

SCHEDULE GROUP AsterX_TouchNonEvolVarsGroup AT post_recover_variables
{
} "Touch Non-Evolution Variables to Bypass CarpetX NaN guard"

SCHEDULE AsterX_FluxAuxZero_Initial IN AsterX_TouchNonEvolVarsGroup
{
  LANG: C

  #######################################################################
  # Suppose to be constructed fully in AsterX_CalcAuxTermsForAvecPsiRHS #
  #######################################################################
  WRITES: Fx_stag(everywhere) Fy_stag(everywhere) Fz_stag(everywhere)
 
  ####################################################
  # Suppose to be constructed fully in AsterX_Fluxes #
  ####################################################
  #WRITES: flux_x(everywhere) flux_y(everywhere) flux_z(everywhere)
  #WRITES: vbar_xface(everywhere) vbar_yface(everywhere) vbar_zface(everywhere)
  #WRITES: a_xface(everywhere) a_yface(everywhere) a_zface(everywhere)
} "Set Fluxes and Auxiliary variables to zero initially"

################################################################################


SCHEDULE AsterX_Sync AT postregrid
{
  LANG: C
  OPTIONS: global
  SYNC: cons_vector Avec_x Avec_y Avec_z Psi
  SYNC: Avec_x_la Avec_y_la Avec_z_la 
  SYNC: saved_prims LOflag
} "Synchronize"

SCHEDULE AsterX_Sync IN ODESolvers_PostStep
{
  LANG: C
  OPTIONS: global
  SYNC: cons_vector Avec_x Avec_y Avec_z Psi
  SYNC: Avec_x_la Avec_y_la Avec_z_la
} "Synchronize"

SCHEDULE AsterX_Sync AT post_recover_variables BEFORE ODESolvers_PostStep AFTER AsterX_TouchNonEvolVarsGroup
{
  LANG: C
  OPTIONS: global
  SYNC: saved_prims
} "Synchronize"

SCHEDULE GROUP AsterX_Con2PrimGroup IN ODESolvers_PostStep BEFORE TmunuBaseX_SetTmunuVars AFTER AsterX_Sync
{
} "Compute primitive variables"

if (!use_ho_fv) {
  SCHEDULE AsterX_ComputedBstagFromA IN AsterX_Con2PrimGroup
  {
    LANG: C
    READS: Avec_x(everywhere) Avec_y(everywhere) Avec_z(everywhere)
    WRITES: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
  } "Calculate dBstag from curl of A"
} else {
  # HO FV: MHD subsystem part 1 - get point val. dB_stag and dB, initially for CA C2P only
  SCHEDULE AsterX_ComputeAvgdBstagFromAvgA IN AsterX_Con2PrimGroup
  {
    LANG: C
    READS: Avec_x(everywhere) Avec_y(everywhere) Avec_z(everywhere)
    WRITES: dBx_stag_fa(everywhere) dBy_stag_fa(everywhere) dBz_stag_fa(everywhere)
    WRITES: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
  } "Calculate <dBstag> from curl of <A>"

  SCHEDULE AsterX_SetdBstagIter IN AsterX_Con2PrimGroup AFTER AsterX_ComputeAvgdBstagFromAvgA 
  {
    LANG: C
    OPTIONS: global
    WRITES: dBstag_pv_iter(everywhere)
  } "Start counter for dBstag iterative calculation"

  SCHEDULE GROUP AsterX_dBstagPVSolve IN AsterX_Con2PrimGroup AFTER AsterX_SetdBstagIter WHILE AsterX::dBstag_pv_iter
  {
  } "Iteratively calculate point valued dBstag"
}

if(!use_subcycling && prolongate_dbstag)
{
  SCHEDULE AsterX_ProlongatedBstag IN AsterX_Con2PrimGroup AFTER AsterX_ComputedBstagFromA AFTER AsterX_dBstagPVSolve BEFORE AsterX_ComputedBFromdBstag
  {
    LANG: C
    OPTIONS: global
  } "Prolongate dBstag only"
}

SCHEDULE AsterX_ComputedBFromdBstag IN AsterX_Con2PrimGroup AFTER AsterX_ComputedBstagFromA AFTER AsterX_dBstagPVSolve 
{
  LANG: C
  READS: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
  WRITES: dB(everywhere)
} "Calculate centered dB from dBstag"

# Extra interprocessor syncs only for higher order stencils
if ((mag_correction_order > 2) || use_ho_fv) {
  SCHEDULE AsterX_CommdBstag IN AsterX_Con2PrimGroup AFTER AsterX_ComputedBstagFromA AFTER AsterX_dBstagPVSolve BEFORE AsterX_ProlongatedBstag BEFORE AsterX_ComputedBFromdBstag 
  {
    LANG: C
    OPTIONS: global
  } "Communicate dBstag between processes"

  SCHEDULE AsterX_CommdB IN AsterX_Con2PrimGroup AFTER AsterX_ComputedBFromdBstag BEFORE AsterX_Con2Prim 
  {
    LANG: C
    OPTIONS: global
  } "Communicate cell centered dB between processes"
}
# if (mag_correction_order > 2) {
#   SCHEDULE AsterX_CommdB IN AsterX_Con2PrimGroup AFTER AsterX_ComputedBFromdBstag BEFORE AsterX_Con2Prim 
#   {
#     LANG: C
#     OPTIONS: global
#   } "Communicate cell centered dB between processes"
# }

# SCHEDULE AsterX_InitCAC2PFlag IN AsterX_Con2PrimGroup BEFORE AsterX_Con2Prim
# {
#   LANG: C
#   OPTIONS: global
#   WRITES: CA_C2P(everywhere)
# } "Determine if we are performing C2P on cell averages or point values"

SCHEDULE AsterX_Con2Prim IN AsterX_Con2PrimGroup AFTER AsterX_ComputedBFromdBstag
{
  LANG: C
  READS: AsterMasks::aster_mask_vc(everywhere)
  READS: ADMBaseX::metric(everywhere)
  READS: ADMBaseX::lapse(everywhere)
  READS: cons_vector(everywhere) dB(everywhere)
  READS: cons_vector_pv(everywhere)
  READS: ADMBaseX::shift(everywhere)
  READS: saved_prims(everywhere)
  READS: Avec_x(everywhere) Avec_y(everywhere) Avec_z(everywhere)
  READS: CA_C2P(everywhere)
  WRITES: con2prim_flag(everywhere)
  WRITES: diagnostics(everywhere)
  WRITES: AsterMasks::aster_mask_cc(everywhere)
  WRITES: HydroBaseX::rho(everywhere) HydroBaseX::vel(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere) HydroBaseX::Bvec(everywhere)
  WRITES: HydroBaseX::temperature(everywhere) HydroBaseX::entropy(everywhere) HydroBaseX::Ye(everywhere)
  WRITES: saved_prims(everywhere)
  WRITES: zvec(everywhere)
  WRITES: svec(everywhere)
  WRITES: cons_vector(everywhere) cons_vector_pv(everywhere) dB(everywhere)
} "Calculate primitive variables from conservative variables"

SCHEDULE AsterX_ApplyOuterBCOnPrim IN AsterX_Con2PrimGroup AFTER AsterX_Con2Prim
{
  LANG: C
  OPTIONS: global
} "Apply CarpetX boundary conditions on primitive variables"

if (use_ho_fv) {
  # HO FV: HD subsystem - Additional C2P to convert 4th order PV Cons to PV Prims; the "real" C2P
  # HO FV: MHD subsystem part 2 - Fall back to 2nd order divergence-free dBstag at shocks
  # SCHEDULE AsterX_UpdateCAC2PFlag IN AsterX_Con2PrimGroup AFTER AsterX_Con2Prim
  # {
  #   LANG: C
  #   OPTIONS: global
  #   WRITES: CA_C2P(everywhere)
  # } "Determine if we are performing C2P on cell averages or point values"

  # SCHEDULE GROUP AsterX_PVCon2PrimGroup IN ODESolvers_PostStep AFTER AsterX_Con2PrimGroup 
  # {
  # } "Compute point valued primitive variables"

  if (shock_Bstag_fallback) {
    SCHEDULE AsterX_ComputedBstagLO IN AsterX_Con2PrimGroup 
    {
      LANG: C
      READS: LOflag(everywhere)
      READS: Avec_x(everywhere) Avec_y(everywhere) Avec_z(everywhere)
      READS: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
      WRITES: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
    } "Calculate 2nd order dBstag from curl of A"

    SCHEDULE AsterX_ComputedBFromdBstag_LOFB IN AsterX_Con2PrimGroup AFTER AsterX_ComputedBstagLO 
    {
      LANG: C
      READS: LOflag(everywhere)
      READS: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
      WRITES: dB(everywhere)
    } "Update centered dB from dBstag with updated low order values"
  }

  # SCHEDULE AsterX_CommdB IN AsterX_PVCon2PrimGroup AFTER AsterX_ComputedBFromdBstag BEFORE AsterX_Con2Prim 
  # {
  #   LANG: C
  #   OPTIONS: global
  # } "Communicate cell centered dB between processes"

  # Convert cell-averages to point values at 4th order
  SCHEDULE AsterX_SetConsIter IN AsterX_Con2PrimGroup BEFORE AsterX_PVConsSolve
  {
    LANG: C
    OPTIONS: global
    WRITES: cons_pv_iter(everywhere)
  } "Start counter for PV cons iterative calculation"

  SCHEDULE GROUP AsterX_PVConsSolve IN AsterX_Con2PrimGroup BEFORE AsterX_Con2Prim WHILE AsterX::cons_pv_iter
  {
  } "Iteratively calculate point valued cons"

  SCHEDULE AsterX_SetPVConsnMinus1 IN AsterX_PVConsSolve 
  {
    LANG: C
    READS: cons_vector(everywhere) cons_vector_pv(everywhere)
    READS: cons_pv_iter(everywhere)
    WRITES: cons_aux(everywhere)
  } "Set previous cons vector"

  SCHEDULE AsterX_SetPointValues IN AsterX_PVConsSolve AFTER AsterX_SetPVConsnMinus1 
  {
    LANG: C
    READS: cons_vector(everywhere) cons_aux(everywhere) LOflag(everywhere)
    WRITES: cons_vector_pv(everywhere)
  } "Iterate cons"

  SCHEDULE AsterX_DecConsIter IN AsterX_PVConsSolve AFTER AsterX_ComputeConsIter 
  {
    LANG: C
    OPTIONS: global
    WRITES: cons_pv_iter(everywhere)
  } "Decrement counter for cons iterative calculation"

  # SCHEDULE AsterX_SetPointValues IN AsterX_PVCon2PrimGroup BEFORE AsterX_Con2Prim
  # {
  #   LANG: C
  #   READS: cons_vector(everywhere) LOflag(everywhere)
  #   WRITES: cons_vector_pv(everywhere)
  # } "Convert cell-averages to point values at 4th order."

  # Extra interprocessor syncs only for higher order FV code
  SCHEDULE AsterX_CommConsPV IN AsterX_Con2PrimGroup AFTER AsterX_SetPointValues BEFORE AsterX_Con2Prim 
  {
    LANG: C
    OPTIONS: global
  } "Communicate cons_vector_pv between processes"

  # SCHEDULE AsterX_Con2Prim IN AsterX_PVCon2PrimGroup 
  # {
  #   LANG: C
  #   READS: AsterMasks::aster_mask_vc(everywhere)
  #   READS: ADMBaseX::metric(everywhere)
  #   READS: ADMBaseX::lapse(everywhere)
  #   READS: cons_vector(everywhere) dB(everywhere)
  #   READS: cons_vector_pv(everywhere)
  #   READS: ADMBaseX::shift(everywhere)
  #   READS: saved_prims(everywhere)
  #   READS: Avec_x(everywhere) Avec_y(everywhere) Avec_z(everywhere)
  #   READS: CA_C2P(everywhere)
  #   WRITES: con2prim_flag(everywhere)
  #   WRITES: diagnostics(everywhere)
  #   WRITES: AsterMasks::aster_mask_cc(everywhere)
  #   WRITES: HydroBaseX::rho(everywhere) HydroBaseX::vel(everywhere) HydroBaseX::eps(everywhere) HydroBaseX::press(everywhere) HydroBaseX::Bvec(everywhere)
  #   WRITES: HydroBaseX::temperature(everywhere) HydroBaseX::entropy(everywhere) HydroBaseX::Ye(everywhere)
  #   WRITES: saved_prims(everywhere)
  #   WRITES: zvec(everywhere)
  #   WRITES: svec(everywhere)
  #   WRITES: cons_vector(everywhere) cons_vector_pv(everywhere) dB(everywhere)
  # } "Calculate primitive variables from conservative variables"

  SCHEDULE AsterX_SetCellAverage IN AsterX_Con2PrimGroup AFTER AsterX_Con2Prim
  {
    LANG: C
    READS: cons_vector_pv(everywhere) 
    READS: LOflag(everywhere) con2prim_flag(everywhere)
    WRITES: cons_vector(everywhere)
  } "Compute cell-averages of conserved variables"

  SCHEDULE AsterX_CommConsCA IN AsterX_Con2PrimGroup AFTER AsterX_SetCellAverage
  {
    LANG: C
    OPTIONS: global
  } "Communicate conservatives between processes"

  # SCHEDULE AsterX_ApplyOuterBCOnPrim IN AsterX_Con2PrimGroup AFTER AsterX_Con2Prim
  # {
  #   LANG: C
  #   OPTIONS: global
  # } "Apply CarpetX boundary conditions on primitive variables"

  SCHEDULE AsterX_InitPointValues AT CCTK_POST_RECOVER_VARIABLES BEFORE ODESolvers_PostStep
  {
    LANG: C
    WRITES: cons_vector_pv(everywhere)
  } "Set point value cons to zero so they are marked as valid before 1st C2P, where they are not used. They will be correctly set at 2nd C2P."

  SCHEDULE AsterX_InitPointValues AT CCTK_POSTREGRID BEFORE ODESolvers_PostStep
  {
    LANG: C
    WRITES: cons_vector_pv(everywhere)
  } "Set point value cons to zero so they are marked as valid before 1st C2P, where they are not used. They will be correctly set at 2nd C2P."
}
else
{
  SCHEDULE AsterX_InitPointValues IN AsterX_Con2PrimGroup BEFORE AsterX_Con2Prim
  {
    LANG: C
    WRITES: cons_vector_pv(everywhere)
  } "Set point value cons to zero so they are marked as valid"
}

SCHEDULE GROUP AsterX_RHSGroup IN ODESolvers_RHS
{
} "Calculate AsterX RHS"

SCHEDULE AsterX_Fluxes IN AsterX_RHSGroup
{
  LANG: C
  READS: ADMBaseX::metric(everywhere)
  READS: ADMBaseX::lapse(everywhere)
  READS: ADMBaseX::shift(everywhere)
  READS: HydroBaseX::rho(everywhere) HydroBaseX::vel(everywhere) HydroBaseX::press(everywhere) HydroBaseX::eps(everywhere)
  READS: HydroBaseX::temperature(everywhere) HydroBaseX::Ye(everywhere)
  READS: HydroBaseX::Bvec(everywhere)
  READS: HydroBaseX::entropy(everywhere)
  READS: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
  READS: zvec_x(everywhere) zvec_y(everywhere) zvec_z(everywhere)
  READS: svec_x(everywhere) svec_y(everywhere) svec_z(everywhere)
  READS: Avec_x(everywhere) Avec_y(everywhere) Avec_z(everywhere) Psi(everywhere)
  READS: cons_vector(everywhere)
  READS: LOflag(everywhere)
  WRITES: flux_x(everywhere) flux_y(everywhere) flux_z(everywhere)
  WRITES: theta_x(everywhere) theta_y(everywhere) theta_z(everywhere)
  WRITES: vbar_xface(everywhere) vbar_yface(everywhere) vbar_zface(everywhere)
  WRITES: a_xface(everywhere) a_yface(everywhere) a_zface(everywhere)
} "Calculate the hydro fluxes"

if(!use_subcycling) {
SCHEDULE AsterX_RestrictFluxes IN AsterX_RHSGroup AFTER AsterX_Fluxes BEFORE AsterX_RHS
{
  LANG: C
  OPTIONS: global
} "Apply CarpetX boundary conditions on flux variables"
}

SCHEDULE AsterX_CalcAuxTermsForAvecPsiRHS IN AsterX_RHSGroup AFTER AsterX_Fluxes BEFORE AsterX_SourceTerms
{
  LANG: C
  READS: ADMBaseX::metric(everywhere)
  READS: ADMBaseX::lapse(everywhere)
  READS: ADMBaseX::shift(everywhere)
  READS: Avec_x(everywhere) Avec_y(everywhere) Avec_z(everywhere) Psi(everywhere)
  READS: flux_x(everywhere) flux_y(everywhere) flux_z(everywhere)
  READS: HydroBaseX::vel(everywhere) HydroBaseX::press(everywhere)
  READS: dBx_stag(everywhere) dBy_stag(everywhere) dBz_stag(everywhere)
  READS: vbar_xface(everywhere) vbar_yface(everywhere) vbar_zface(everywhere)
  READS: a_xface(everywhere) a_yface(everywhere) a_zface(everywhere)
  READS: Fx_stag(everywhere) Fy_stag(everywhere) Fz_stag(everywhere)
  WRITES: Ex(interior) Ey(interior) Ez(interior)
  WRITES: G(everywhere)
  WRITES: Fbeta(everywhere)
  WRITES: Fx_stag(everywhere) Fy_stag(everywhere) Fz_stag(everywhere)
} "Calculate the auxiliary terms for the rhs of Avec and Psi"

if(!use_subcycling) {
SCHEDULE AsterX_RestrictAuxTermsForAvecPsiRHS IN AsterX_RHSGroup AFTER AsterX_CalcAuxTermsForAvecPsiRHS BEFORE AsterX_SourceTerms
{
  LANG: C
  OPTIONS: global
} "Restrict the auxiliary terms for the rhs of Avec and Psi"
}

SCHEDULE AsterX_SourceTerms IN AsterX_RHSGroup AFTER AsterX_Fluxes
{
  LANG: C
  READS: ADMBaseX::metric(everywhere)
  READS: ADMBaseX::lapse(everywhere)
  READS: ADMBaseX::shift(everywhere)
  READS: ADMBaseX::curv(everywhere)
  READS: HydroBaseX::rho(everywhere) HydroBaseX::press(everywhere) HydroBaseX::eps(everywhere)
  READS: HydroBaseX::vel(everywhere)
  READS: zvec_x(everywhere), zvec_y(everywhere), zvec_z(everywhere)
  READS: svec_x(everywhere), svec_y(everywhere), svec_z(everywhere)
  READS: HydroBaseX::Bvec(everywhere)
  WRITES: rhs_vector(interior)
  WRITES: rhs_vector_pv(interior)
} "Calculate the source terms and compute the RHS of the hydro equations"

if (use_ho_fv) {
  SCHEDULE AsterX_CellAvgSourceTerms IN AsterX_RHSGroup AFTER AsterX_SourceTerms BEFORE AsterX_RHS
  {
    LANG: C
    READS: LOflag(interior)
    READS: rhs_vector_pv(interior)
    WRITES: rhs_vector(interior)
  } "Cell average source term"
}

SCHEDULE AsterX_RHS IN AsterX_RHSGroup AFTER AsterX_SourceTerms
{
  LANG: C
  READS: ADMBaseX::metric(everywhere) ADMBaseX::lapse(everywhere) ADMBaseX::shift(everywhere)
  READS: flux_x(everywhere) flux_y(everywhere) flux_z(everywhere)
  READS: rhs_vector(interior)
  READS: Psi(everywhere)
  READS: Ex(interior) Ey(interior) Ez(interior)
  READS: G(everywhere)
  READS: Fbeta(everywhere)
  READS: Fx_stag(everywhere) Fy_stag(everywhere) Fz_stag(everywhere)
  READS: theta_x(everywhere) theta_y(everywhere) theta_z(everywhere)
  READS: LOflag(everywhere) 
  WRITES: rhs_vector(interior)
  WRITES: theta_tot(interior)
  WRITES: Avec_x_rhs(interior) Avec_y_rhs(interior) Avec_z_rhs(interior) Psi_rhs(interior)
  WRITES: Avec_x_la_rhs(interior) Avec_y_la_rhs(interior) Avec_z_la_rhs(interior)
} "Update the RHS of the hydro equations with the flux contributions"



if(interpolate_failed_c2p)
{
  SCHEDULE AsterX_Con2Prim_Interpolate_Failed IN AsterX_RHSGroup BEFORE AsterX_Fluxes
  {
    LANG: C
    READS: ADMBaseX::metric(interior)
    READS: con2prim_flag(interior)
    READS: HydroBaseX::rho(interior) HydroBaseX::vel(interior) HydroBaseX::eps(interior) HydroBaseX::press(interior) HydroBaseX::Bvec(interior)
    READS: saved_prims(interior)
    READS: cons_vector(interior)
    WRITES: con2prim_flag(interior)
    WRITES: HydroBaseX::rho(interior) HydroBaseX::vel(interior) HydroBaseX::eps(interior) HydroBaseX::press(interior)
    WRITES: saved_prims(interior)
    WRITES: cons_vector(interior)
    SYNC: con2prim_flag
    SYNC: HydroBaseX::rho HydroBaseX::vel HydroBaseX::eps HydroBaseX::press
    SYNC: saved_prims
    SYNC: cons_vector
  } "Interpolate those grid points where con2prim failed"
}
  
if(update_tmunu){
  SCHEDULE AsterX_Tmunu IN TmunuBaseX_AddToTmunu
  {
    LANG: C
    READS: ADMBaseX::metric(everywhere) ADMBaseX::lapse(everywhere) ADMBaseX::shift(everywhere)
    READS: HydroBaseX::rho(everywhere) HydroBaseX::press(everywhere) HydroBaseX::eps(everywhere)
    READS: HydroBaseX::vel(everywhere)
    READS: zvec_x(everywhere), zvec_y(everywhere), zvec_z(everywhere)
    READS: svec_x(everywhere), svec_y(everywhere), svec_z(everywhere)
    READS: HydroBaseX::Bvec(everywhere)
    READS: TmunuBaseX::eTtt(interior) TmunuBaseX::eTti(interior) TmunuBaseX::eTij(interior)
    WRITES: TmunuBaseX::eTtt(interior) TmunuBaseX::eTti(interior) TmunuBaseX::eTij(interior)
    #SYNC: TmunuBaseX::eTtt TmunuBaseX::eTti TmunuBaseX::eTij
  } "Compute the energy-momentum tensor"
}

if(add_dissipation)
{
  SCHEDULE AsterX_Add_Dissipation_AvecPsi IN AsterX_RHSGroup \
     AFTER AsterX_RHS
  {
    LANG: C
    READS: Avec_x(everywhere) Avec_y(everywhere) Avec_z(everywhere) Psi(everywhere)
    READS: Avec_x_rhs(everywhere) Avec_y_rhs(everywhere) Avec_z_rhs(everywhere) Psi_rhs(everywhere)
    WRITES: Avec_x_rhs(interior) Avec_y_rhs(interior) Avec_z_rhs(interior) Psi_rhs(interior)
  } "Add KO dissipation"
}
