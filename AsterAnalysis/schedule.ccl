# Schedule definitions for thorn AsterAnalysis

if (compute_MHD) {
  STORAGE: mhd_analysis
  SCHEDULE AsterAnalysis_MHD AT analysis
  {
    LANG: C
    READS: ADMBaseX::metric(everywhere)
    READS: ADMBaseX::lapse(everywhere)
    READS: ADMBaseX::shift(everywhere)
    READS: HydroBaseX::rho(everywhere)
    READS: HydroBaseX::eps(everywhere)
    READS: HydroBaseX::press(everywhere)
    READS: HydroBaseX::vel(everywhere)
    READS: HydroBaseX::Bvec(everywhere)
    READS: AsterX::zvec(everywhere)
    READS: AsterX::B_norm(everywhere)
    READS: AsterX::b2small(everywhere)
    READS: AsterX::w_lorentz(everywhere)
    READS: AsterX::Avec_x(everywhere)
    READS: AsterX::Avec_y(everywhere)
    READS: AsterX::Avec_z(everywhere)
    READS: AsterX::dBx_stag(everywhere)
    READS: AsterX::dBy_stag(everywhere)
    READS: AsterX::dBz_stag(everywhere)
    WRITES: mhd_analysis(interior)
  }
  "Compute MHD analysis quantities"

  if (use_ho_fv) {
    STORAGE: mhd_analysis_hofv
    STORAGE: dBx_stag_err dBy_stag_err dBz_stag_err
    SCHEDULE AsterAnalysis_HOFV AT analysis
    {
      LANG: C
      READS: ADMBaseX::metric(everywhere)
      READS: AsterX::dBx_stag(everywhere)
      READS: AsterX::dBy_stag(everywhere)
      READS: AsterX::dBz_stag(everywhere)
      READS: AsterX::dBx_stag_fa(everywhere)
      READS: AsterX::dBy_stag_fa(everywhere)
      READS: AsterX::dBz_stag_fa(everywhere)
      READS: AsterX::dens(everywhere)
      READS: AsterX::tau(everywhere)
      READS: AsterX::tau_pv(everywhere)
      READS: AsterX::LOflag(everywhere)
      WRITES: mhd_analysis_hofv(interior)
      WRITES: dBx_stag_err(interior) dBy_stag_err(interior) dBz_stag_err(interior)
    }
    "Compute MHD analysis quantities"
  }
}

if (compute_MHD_spherical) {
  STORAGE: mhd_spherical
  SCHEDULE AsterAnalysis_MHD_Spherical AT analysis AFTER AsterAnalysis_MHD
  {
    LANG: C
    READS: AsterX::w_lorentz(interior)
    READS: ADMBaseX::metric(interior)
    READS: HydroBaseX::Bvec(interior)
    READS: HydroBaseX::rho(interior)
    WRITES: mhd_spherical(interior)
  }
  "Compute MHD analysis quantities in spherical coordinates"
}

