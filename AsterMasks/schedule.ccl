#Schedule definitions for thorn AsterMasks

STORAGE: aster_mask_vc
STORAGE: aster_mask_cc

#SCHEDULE AsterMasks_Initialize IN CCTK_INITIAL BEFORE ODESolvers_Initial {
#LANG: C
#WRITES: aster_mask_vc(everywhere)
#WRITES: aster_mask_cc(everywhere)
#} "Initialize VC and CC mask to true"

#SCHEDULE AsterMasks_Initialize IN CCTK_POSTREGRID BEFORE ODESolvers_PostStep {
#LANG: C
#WRITES: aster_mask_vc(everywhere)
#WRITES: aster_mask_cc(everywhere)
#} "Initialize VC and CC mask to true"

#SCHEDULE AsterMasks_Initialize IN CCTK_POST_RECOVER_VARIABLES BEFORE ODESolvers_PostStep {
#LANG: C
#WRITES: aster_mask_vc(everywhere)
#WRITES: aster_mask_cc(everywhere)
#} "Initialize VC and CC mask to true"

# ----- CCTK_INITIAL

SCHEDULE AsterMasks_One IN CCTK_INITIAL BEFORE ODESolvers_Initial {
LANG: C
WRITES:  aster_mask_vc(everywhere) aster_mask_cc(everywhere)
} "Set masks = 1"

SCHEDULE AsterMasks_ActuallySetZero IN CCTK_INITIAL BEFORE ODESolvers_Initial AFTER AsterMasks_Init {
LANG: C
OPTIONS: global
WRITES:  actually_set
} "Set actually_set = 0"

# ----- ODESolvers_PostStep

SCHEDULE AsterMasks_OnePostStep IN ODESolvers_PostStep BEFORE ADMBaseX_SetADMVars {
LANG: C
READS:  actually_set
READS:  aster_mask_vc(everywhere) aster_mask_cc(everywhere)
WRITES: aster_mask_vc(everywhere) aster_mask_cc(everywhere)
} "If (actually_set = 1) masks = 1"

SCHEDULE AsterMasks_ActuallySetZero IN ODESolvers_PostStep BEFORE ADMBaseX_SetADMVars AFTER AsterMasks_OnePostStep {
LANG: C
OPTIONS: global
WRITES:  actually_set
} "Set actually_set = 0"

# ----- CCTK_POSTREGRID

SCHEDULE AsterMasks_One IN CCTK_POSTREGRID BEFORE ODESolvers_PostStep {
LANG: C
WRITES: aster_mask_vc(everywhere) aster_mask_cc(everywhere)
} "Set masks = 1"

SCHEDULE AsterMasks_ActuallySetZero IN CCTK_POSTREGRID BEFORE ODESolvers_PostStep AFTER AsterMasks_One {
LANG: C
OPTIONS: global
WRITES:  actually_set
} "Set actually_set = 0"

# ----- CCTK_POST_RECOVER_VARIABLES

SCHEDULE AsterMasks_One IN CCTK_POST_RECOVER_VARIABLES BEFORE ODESolvers_PostStep {
LANG: C
WRITES: aster_mask_vc(everywhere) aster_mask_cc(everywhere)
} "Set masks = 1"

SCHEDULE AsterMasks_ActuallySetZero IN CCTK_POST_RECOVER_VARIABLES BEFORE ODESolvers_PostStep AFTER AsterMasks_One {
LANG: C
OPTIONS: global
WRITES:  actually_set
} "Set actually_set = 0"
