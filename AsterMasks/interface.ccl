# Interface definition for thorn AsterMasks

IMPLEMENTS: AsterMasks

USES INCLUDE HEADER: loop_device.hxx

PUBLIC:

CCTK_REAL aster_mask_vc CENTERING={vvv} TYPE=gf TAGS='checkpoint="no"' "Vertex-centered mask"
CCTK_REAL aster_mask_cc CENTERING={ccc} TYPE=gf TAGS='checkpoint="no"' "Cell-centered mask"

# This scalar can be used by external thorns to indicate 
# whether we reset the gridfunctions above as 
# AsterMasks_Initialize is always scheduled. We set the 
# gfs to one if: actually_set = 1 
# actually_set = 0 by default most of the time
CCTK_REAL actually_set TYPE=scalar "Whether we actually set the gridfunctions above to one"
